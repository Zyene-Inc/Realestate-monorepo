// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SALES_ADMIN
  TENANT_ADMIN
  AGENT
  TENANT
}

enum AgentAccountStatus {
  PENDING
  APPROVED
  DECLINED
  SUSPENDED
}

enum PropertyOwnerPayoutStatus {
  PENDING_ONBOARDING
  ACTIVE
  RESTRICTED
  DISABLED
}

enum ListingType {
  SALE
  RENT
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InquiryStatus {
  OPEN
  CLOSED
}

enum InquirySenderType {
  BUYER
  AGENT
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum CommissionPaymentMethod {
  ACH
  CASH
  CHECK
  WIRE
  OTHER
}

enum SaleCommissionStatus {
  ACTIVE
  VOIDED
}

enum SaleCommissionEventType {
  CREATED
  CORRECTED
  VOIDED
}

enum ESignatureProvider {
  VERDOCS
}

enum ESignatureDocumentType {
  LEASE
  DISCLOSURE
  AGREEMENT
}

enum ESignatureTargetType {
  TENANT
  AGENT
}

enum ESignatureEnvelopeStatus {
  CREATING
  PENDING
  IN_PROGRESS
  FINALIZING
  COMPLETED
  DECLINED
  CANCELED
  EXPIRED
  FAILED
}

enum ESignatureEventSource {
  LOCAL
  VERDOCS
}

enum ESignatureStoredDocumentType {
  SIGNED_DOCUMENT
  CERTIFICATE
}

model User {
  id                  String                @id @default(cuid())
  authUserId          String                @unique @db.Uuid
  email               String                @unique
  role                Role                  @default(TENANT)
  status              UserStatus            @default(INVITED)
  failedLoginAttempts Int                   @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tenantProfile       Tenant?
  agentProfile        Agent?                @relation("AgentUser")
  approvedAgents      Agent[]               @relation("AgentApprovedBy")
  reviewedProperties  Property[]            @relation("PropertyReviewedBy")
  sentMessages        Message[]             @relation("SentMessages")
  receivedMessages    Message[]             @relation("ReceivedMessages")
  auditLogs           AuditLog[]
  notifications       Notification[]
  recordedCommissions SaleCommission[]      @relation("SaleCommissionRecordedBy")
  voidedCommissions   SaleCommission[]      @relation("SaleCommissionVoidedBy")
  commissionEvents    SaleCommissionEvent[] @relation("SaleCommissionEventActor")
  createdESignatures  ESignatureEnvelope[]  @relation("ESignatureCreatedBy")
}

model Agent {
  id                       String               @id @default(cuid())
  userId                   String               @unique
  user                     User                 @relation("AgentUser", fields: [userId], references: [id])
  companyName              String
  contactName              String
  email                    String               @unique
  phone                    String?
  accountStatus            AgentAccountStatus   @default(PENDING)
  stripeConnectedAccountId String?              @unique
  verificationDocuments    String[]
  approvedAt               DateTime?
  approvedByUserId         String?
  approvedBy               User?                @relation("AgentApprovedBy", fields: [approvedByUserId], references: [id])
  declineReason            String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  properties               Property[]
  listingInquiries         ListingInquiry[]
  saleCommissions          SaleCommission[]
  eSignatureEnvelopes      ESignatureEnvelope[]

  @@index([accountStatus])
  @@index([approvedByUserId])
}

model PropertyOwner {
  id                       String                    @id @default(cuid())
  ownerName                String?
  companyName              String?
  contactEmail             String
  contactPhone             String?
  stripeConnectedAccountId String?                   @unique
  payoutStatus             PropertyOwnerPayoutStatus @default(PENDING_ONBOARDING)
  commissionRate           Decimal                   @default(10.00) @db.Decimal(5, 2)
  stripeAccountLastSyncedAt DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  onboardedAt              DateTime?
  properties               Property[]
  payments                 Payment[]

  @@index([payoutStatus])
}

model Property {
  id                  String               @id @default(cuid())
  listingType         ListingType          @default(RENT)
  listingStatus       ListingStatus?
  publishStatus       PublishStatus        @default(DRAFT)
  ownerId             String?
  owner               PropertyOwner?       @relation(fields: [ownerId], references: [id])
  agentId             String?
  agent               Agent?               @relation(fields: [agentId], references: [id])
  reviewedByUserId    String?
  reviewedBy          User?                @relation("PropertyReviewedBy", fields: [reviewedByUserId], references: [id])
  name                String
  address             String
  city                String
  state               String
  zip                 String
  propertyType        String // single family, duplex, apartment, commercial
  description         String?
  price               Decimal?             @db.Decimal(12, 2)
  rentAmount          Decimal?             @db.Decimal(12, 2)
  bedrooms            Int?
  bathrooms           Float?
  squareFeet          Int?
  availabilityDate    DateTime?
  amenities           String[]
  utilityInfo         String?
  photos              String[]
  documents           String[]
  status              String               @default("active")
  submittedAt         DateTime?
  reviewedAt          DateTime?
  rejectionReason     String?
  publishedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  units               Unit[]
  maintenanceRequests MaintenanceRequest[]
  announcements       Announcement[]
  listingInquiries    ListingInquiry[]
  saleCommissions     SaleCommission[]
  eSignatureEnvelopes ESignatureEnvelope[]

  @@index([ownerId])
  @@index([agentId])
  @@index([reviewedByUserId])
  @@index([listingType, listingStatus])
  @@index([listingType, publishStatus, updatedAt(sort: Desc), id(sort: Desc)])
}

model ListingInquiry {
  id                        String                  @id @default(cuid())
  propertyId                String
  property                  Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId                   String
  agent                     Agent                   @relation(fields: [agentId], references: [id])
  buyerName                 String
  buyerEmail                String
  buyerPhone                String?
  buyerAccessTokenHash      String                  @unique
  buyerAccessTokenExpiresAt DateTime
  status                    InquiryStatus           @default(OPEN)
  agentLastReadAt           DateTime?
  lastMessageAt             DateTime                @default(now())
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  messages                  ListingInquiryMessage[]

  @@index([agentId, status, lastMessageAt])
  @@index([agentId, lastMessageAt(sort: Desc)])
  @@index([lastMessageAt(sort: Desc)])
  @@index([propertyId, lastMessageAt])
}

model ListingInquiryMessage {
  id         String            @id @default(cuid())
  inquiryId  String
  inquiry    ListingInquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderType InquirySenderType
  body       String
  readAt     DateTime?
  createdAt  DateTime          @default(now())

  @@index([inquiryId, createdAt])
}

model ChatConversation {
  id              String        @id @default(cuid())
  accessTokenHash String        @unique @db.Char(64)
  lastMessageAt   DateTime      @default(now())
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  messages        ChatMessage[]

  @@index([expiresAt])
  @@index([lastMessageAt(sort: Desc), id(sort: Desc)])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatMessageRole
  content        String
  visitorDayHash String?          @db.Char(64)
  model          String?
  finishReason   String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([visitorDayHash, createdAt])
  @@index([role, createdAt])
}

model Unit {
  id                  String               @id @default(cuid())
  propertyId          String
  property            Property             @relation(fields: [propertyId], references: [id])
  unitNumber          String
  floor               String?
  bedrooms            Int
  bathrooms           Float
  squareFeet          Int
  rentAmount          Float
  depositAmount       Float
  status              String               @default("vacant") // vacant, occupied, under maintenance, off market
  availableDate       DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenants             Tenant[]
  leases              Lease[]
  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]
  announcements       Announcement[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId, status])
}

model Tenant {
  id                    String               @id @default(cuid())
  firstName             String
  lastName              String
  email                 String               @unique
  phone                 String?
  dateOfBirth           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  vehicleInfo           String?
  petInfo               String?
  status                String               @default("invited")
  lastMessageAt         DateTime?
  userId                String?              @unique
  user                  User?                @relation(fields: [userId], references: [id])
  unitId                String?
  unit                  Unit?                @relation(fields: [unitId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  leases                Lease[]
  payments              Payment[]
  maintenanceRequests   MaintenanceRequest[]
  messages              Message[]
  documents             Document[]
  autopay               AutoPay?
  eSignatureEnvelopes   ESignatureEnvelope[]

  @@index([unitId, status])
  @@index([lastMessageAt(sort: Desc), id(sort: Desc)])
}

model Lease {
  id                  String               @id @default(cuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  unitId              String
  unit                Unit                 @relation(fields: [unitId], references: [id])
  startDate           DateTime
  endDate             DateTime
  monthlyRent         Float
  rentDueDay          Int                  @default(1)
  gracePeriodDays     Int                  @default(5)
  lateFeeAmount       Float                @default(50)
  securityDeposit     Float
  leasePdfUrl         String?
  status              String               @default("active") // active, expiring, renewed, terminated
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  payments            Payment[]
  eSignatureEnvelopes ESignatureEnvelope[]

  @@index([tenantId, status, endDate])
  @@index([unitId, status])
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
  WAIVED
  REFUNDED
}

enum StripeCheckoutStatus {
  NOT_STARTED
  OPEN
  COMPLETE
  FAILED
  EXPIRED
}

enum StripeWebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model Payment {
  id                         String         @id @default(cuid())
  tenantId                   String
  tenant                     Tenant         @relation(fields: [tenantId], references: [id])
  leaseId                    String
  lease                      Lease          @relation(fields: [leaseId], references: [id])
  unitId                     String
  unit                       Unit           @relation(fields: [unitId], references: [id])
  propertyOwnerId            String?
  propertyOwner              PropertyOwner? @relation(fields: [propertyOwnerId], references: [id], onDelete: Restrict)
  rentAmount                 Float
  lateFee                    Float          @default(0)
  totalAmount                Float
  paidAmount                 Float          @default(0)
  balanceDue                 Float
  paymentMethod              String? // cash, check, Zelle, bank transfer, other
  referenceNumber            String?        @unique
  idempotencyKey             String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordRequestFingerprint   String?        @db.VarChar(64)
  lastStatusRequestId        String?        @unique @db.Uuid
  status                     PaymentStatus  @default(PENDING)
  paidAt                     DateTime?
  ownerCommissionRate        Decimal?       @db.Decimal(5, 2)
  managementCommissionAmount Decimal?       @db.Decimal(12, 2)
  ownerProceedsAmount        Decimal?       @db.Decimal(12, 2)
  dueDate                    DateTime
  receiptUrl                 String?
  notes                      String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  // Tenant-initiated, one-time Checkout records. No subscription or off-session
  // collection is permitted for rental payments.
  stripeCustomerId        String?
  stripeCheckoutSessionId String?              @unique
  stripeCheckoutUrl       String?              @db.Text
  stripeCheckoutStatus    StripeCheckoutStatus @default(NOT_STARTED)
  stripeCheckoutExpiresAt DateTime?
  stripePaymentIntentId   String?              @unique
  stripeChargeId          String?              @unique
  stripeTransferId        String?
  stripePaymentMethodType String?
  stripeLastEventAt       DateTime?
  stripeWebhookEvents     StripeWebhookEvent[]

  @@index([propertyOwnerId, paidAt(sort: Desc), id(sort: Desc)])
  @@index([status, paidAt(sort: Desc), id(sort: Desc)])
  @@index([stripeCheckoutStatus, stripeCheckoutExpiresAt])
  @@index([tenantId])
  @@index([leaseId])
  @@index([unitId])
}

model StripeWebhookEvent {
  id              String                    @id @default(cuid())
  stripeEventId   String                    @unique
  type            String
  livemode        Boolean
  status          StripeWebhookEventStatus  @default(RECEIVED)
  paymentId       String?
  payment         Payment?                  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  payload         String                    @db.Text
  processingError String?                   @db.Text
  processedAt     DateTime?
  createdAt       DateTime                  @default(now())

  @@index([type, createdAt(sort: Desc), id(sort: Desc)])
  @@index([paymentId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
}

model PaymentMethod {
  id             String  @id @default(cuid())
  tenantId       String
  stripeMethodId String
  type           String // card, us_bank_account
  last4          String
  isDefault      Boolean @default(false)
}

model AutoPay {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  enabled         Boolean  @default(false)
  paymentMethodId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MaintenanceRequest {
  id                   String    @id @default(cuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  unitId               String
  unit                 Unit      @relation(fields: [unitId], references: [id])
  propertyId           String
  property             Property  @relation(fields: [propertyId], references: [id])
  category             String // plumbing, electrical, HVAC, appliance, pest, structural, other
  priority             String // low, medium, high, emergency
  description          String
  photos               String[]
  preferredAccessTimes String?
  status               String    @default("submitted") // submitted, reviewed, assigned, scheduled, in_progress, completed, tenant_confirmed
  assignedVendorId     String?
  vendor               Vendor?   @relation(fields: [assignedVendorId], references: [id])
  scheduledDate        DateTime?
  cost                 Float?
  adminNotes           String?
  tenantRating         Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([propertyId, status])
  @@index([unitId])
  @@index([assignedVendorId])
}

model Vendor {
  id                  String               @id @default(cuid())
  name                String
  companyName         String?
  email               String?
  phone               String?
  specialty           String?
  rating              Float?
  notes               String?
  createdAt           DateTime             @default(now())
  maintenanceRequests MaintenanceRequest[]
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  sender     User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  subject    String?
  body       String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([receiverId, isRead, createdAt(sort: Desc)])
  @@index([senderId])
}

model Announcement {
  id         String    @id @default(cuid())
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id])
  title      String
  content    String
  createdAt  DateTime  @default(now())

  @@index([propertyId])
  @@index([unitId])
}

model Document {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  url       String
  type      String // Lease, ID, Income, Notice, etc.
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SaleCommission {
  id                 String                  @id @default(cuid())
  idempotencyKey     String                  @unique @db.Uuid
  requestFingerprint String?                 @db.VarChar(64)
  propertyId         String
  property           Property                @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  agentId            String
  agent              Agent                   @relation(fields: [agentId], references: [id], onDelete: Restrict)
  salePrice          Decimal?                @db.Decimal(14, 2)
  commissionAmount   Decimal                 @db.Decimal(14, 2)
  currency           String                  @default("USD") @db.Char(3)
  receivedAt         DateTime
  paymentMethod      CommissionPaymentMethod
  referenceNumber    String?
  notes              String?
  status             SaleCommissionStatus    @default(ACTIVE)
  recordedByUserId   String
  recordedBy         User                    @relation("SaleCommissionRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  voidedAt           DateTime?
  voidReason         String?
  voidedByUserId     String?
  voidedBy           User?                   @relation("SaleCommissionVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  events             SaleCommissionEvent[]

  @@index([receivedAt(sort: Desc), id(sort: Desc)])
  @@index([status, receivedAt(sort: Desc), id(sort: Desc)])
  @@index([propertyId])
  @@index([agentId, receivedAt(sort: Desc), id(sort: Desc)])
  @@index([recordedByUserId])
  @@index([voidedByUserId])
}

model SaleCommissionEvent {
  id           String                  @id @default(cuid())
  commissionId String
  commission   SaleCommission          @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  type         SaleCommissionEventType
  actorUserId  String
  actor        User                    @relation("SaleCommissionEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  oldValue     Json?
  newValue     Json?
  reason       String?
  createdAt    DateTime                @default(now())

  @@index([commissionId, createdAt, id])
  @@index([actorUserId])
}

model ESignatureEnvelope {
  id                 String                   @id @default(cuid())
  clientRequestId    String                   @unique @db.Uuid
  provider           ESignatureProvider       @default(VERDOCS)
  providerEnvelopeId String?                  @unique @db.Uuid
  templateId         String                   @db.Uuid
  documentType       ESignatureDocumentType
  targetType         ESignatureTargetType
  status             ESignatureEnvelopeStatus @default(CREATING)
  providerStatus     String?
  title              String
  tenantId           String?
  tenant             Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agentId            String?
  agent              Agent?                   @relation(fields: [agentId], references: [id], onDelete: Restrict)
  leaseId            String?
  lease              Lease?                   @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  propertyId         String?
  property           Property?                @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  recipientRoleName  String
  recipientEmail     String
  recipientFirstName String
  recipientLastName  String
  recipientStatus    String?
  createdByUserId    String
  createdBy          User                     @relation("ESignatureCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sentAt             DateTime?
  openedAt           DateTime?
  completedAt        DateTime?
  declinedAt         DateTime?
  canceledAt         DateTime?
  expiredAt          DateTime?
  expiresAt          DateTime?
  archivedAt         DateTime?
  lastSyncedAt       DateTime?
  failureReason      String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  events             ESignatureEvent[]
  documents          ESignatureDocument[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([leaseId])
  @@index([propertyId])
  @@index([createdByUserId])
}

model ESignatureEvent {
  id              String                @id @default(cuid())
  envelopeId      String
  envelope        ESignatureEnvelope    @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  providerEventId String                @unique
  source          ESignatureEventSource
  eventType       String
  actor           String?
  payload         Json?
  occurredAt      DateTime
  createdAt       DateTime              @default(now())

  @@index([envelopeId, occurredAt, id])
}

model ESignatureDocument {
  id                 String                       @id @default(cuid())
  envelopeId         String
  envelope           ESignatureEnvelope           @relation(fields: [envelopeId], references: [id], onDelete: Restrict)
  providerDocumentId String                       @db.Uuid
  documentType       ESignatureStoredDocumentType
  name               String
  mime               String
  size               Int
  storagePath        String                       @unique
  sha256             String                       @db.Char(64)
  providerCreatedAt  DateTime?
  archivedAt         DateTime                     @default(now())
  createdAt          DateTime                     @default(now())

  @@unique([envelopeId, providerDocumentId])
  @@index([envelopeId, archivedAt, id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([resource, createdAt(sort: Desc), id(sort: Desc)])
  @@index([action, createdAt(sort: Desc), id(sort: Desc)])
}

model EmailLog {
  id                     String       @id @default(cuid())
  to                     String
  subject                String
  body                   String?
  templateKey            String
  templateVersion        Int          @default(1)
  status                 String       @default("PENDING")
  critical               Boolean      @default(false)
  idempotencyKey         String       @unique
  providerIdempotencyKey String
  resendEmailId          String?      @unique
  attemptCount           Int          @default(0)
  maxAttempts            Int          @default(1)
  nextRetryAt            DateTime?
  lastAttemptAt          DateTime?
  lastError              String?
  sentAt                 DateTime?
  deliveredAt            DateTime?
  openedAt               DateTime?
  clickedAt              DateTime?
  bouncedAt              DateTime?
  complainedAt           DateTime?
  failedAt               DateTime?
  suppressedAt           DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  events                 EmailEvent[]

  @@index([status, nextRetryAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model EmailEvent {
  id                String   @id @default(cuid())
  emailLogId        String
  emailLog          EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)
  providerEventId   String   @unique
  type              String
  providerCreatedAt DateTime
  payload           Json?
  createdAt         DateTime @default(now())

  @@index([emailLogId, providerCreatedAt])
}
