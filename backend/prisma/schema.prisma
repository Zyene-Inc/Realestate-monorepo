// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SALES_ADMIN
  TENANT_ADMIN
  AGENT
  TENANT
}

enum AgentAccountStatus {
  PENDING
  APPROVED
  DECLINED
  SUSPENDED
}

enum PropertyOwnerPayoutStatus {
  PENDING_ONBOARDING
  ACTIVE
  RESTRICTED
  DISABLED
}

enum ListingType {
  SALE
  RENT
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InquiryStatus {
  OPEN
  CLOSED
}

enum InquirySenderType {
  BUYER
  AGENT
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id                 String         @id @default(cuid())
  authUserId         String         @unique @db.Uuid
  email              String         @unique
  role               Role           @default(TENANT)
  status             UserStatus     @default(INVITED)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  tenantProfile      Tenant?
  agentProfile       Agent?         @relation("AgentUser")
  approvedAgents     Agent[]        @relation("AgentApprovedBy")
  reviewedProperties Property[]     @relation("PropertyReviewedBy")
  sentMessages       Message[]      @relation("SentMessages")
  receivedMessages   Message[]      @relation("ReceivedMessages")
  auditLogs          AuditLog[]
  notifications      Notification[]
}

model Agent {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  user                     User               @relation("AgentUser", fields: [userId], references: [id])
  companyName              String
  contactName              String
  email                    String             @unique
  phone                    String?
  accountStatus            AgentAccountStatus @default(PENDING)
  stripeConnectedAccountId String?            @unique
  verificationDocuments    String[]
  approvedAt               DateTime?
  approvedByUserId         String?
  approvedBy               User?              @relation("AgentApprovedBy", fields: [approvedByUserId], references: [id])
  declineReason            String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  properties               Property[]
  listingInquiries         ListingInquiry[]

  @@index([accountStatus])
  @@index([approvedByUserId])
}

model PropertyOwner {
  id                       String                    @id @default(cuid())
  ownerName                String?
  companyName              String?
  contactEmail             String
  contactPhone             String?
  stripeConnectedAccountId String?                   @unique
  payoutStatus             PropertyOwnerPayoutStatus @default(PENDING_ONBOARDING)
  commissionRate           Decimal                   @default(10.00) @db.Decimal(5, 2)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  onboardedAt              DateTime?
  properties               Property[]

  @@index([payoutStatus])
}

model Property {
  id                  String               @id @default(cuid())
  listingType         ListingType          @default(RENT)
  listingStatus       ListingStatus?
  publishStatus       PublishStatus        @default(DRAFT)
  ownerId             String?
  owner               PropertyOwner?       @relation(fields: [ownerId], references: [id])
  agentId             String?
  agent               Agent?               @relation(fields: [agentId], references: [id])
  reviewedByUserId    String?
  reviewedBy          User?                @relation("PropertyReviewedBy", fields: [reviewedByUserId], references: [id])
  name                String
  address             String
  city                String
  state               String
  zip                 String
  propertyType        String // single family, duplex, apartment, commercial
  description         String?
  price               Decimal?             @db.Decimal(12, 2)
  rentAmount          Decimal?             @db.Decimal(12, 2)
  bedrooms            Int?
  bathrooms           Float?
  squareFeet          Int?
  availabilityDate    DateTime?
  amenities           String[]
  utilityInfo         String?
  photos              String[]
  documents           String[]
  status              String               @default("active")
  submittedAt         DateTime?
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  units               Unit[]
  maintenanceRequests MaintenanceRequest[]
  announcements       Announcement[]
  listingInquiries    ListingInquiry[]

  @@index([ownerId])
  @@index([agentId])
  @@index([reviewedByUserId])
  @@index([listingType, listingStatus])
  @@index([listingType, publishStatus])
}

model ListingInquiry {
  id                   String                  @id @default(cuid())
  propertyId           String
  property             Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId              String
  agent                Agent                   @relation(fields: [agentId], references: [id])
  buyerName            String
  buyerEmail           String
  buyerPhone           String?
  buyerAccessTokenHash String                  @unique
  status               InquiryStatus           @default(OPEN)
  agentLastReadAt      DateTime?
  lastMessageAt        DateTime                @default(now())
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  messages             ListingInquiryMessage[]

  @@index([agentId, status, lastMessageAt])
  @@index([agentId, lastMessageAt(sort: Desc)])
  @@index([lastMessageAt(sort: Desc)])
  @@index([propertyId, lastMessageAt])
}

model ListingInquiryMessage {
  id         String            @id @default(cuid())
  inquiryId  String
  inquiry    ListingInquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderType InquirySenderType
  body       String
  readAt     DateTime?
  createdAt  DateTime          @default(now())

  @@index([inquiryId, createdAt])
}

model Unit {
  id                  String               @id @default(cuid())
  propertyId          String
  property            Property             @relation(fields: [propertyId], references: [id])
  unitNumber          String
  floor               String?
  bedrooms            Int
  bathrooms           Float
  squareFeet          Int
  rentAmount          Float
  depositAmount       Float
  status              String               @default("vacant") // vacant, occupied, under maintenance, off market
  availableDate       DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenants             Tenant[]
  leases              Lease[]
  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]
  announcements       Announcement[]
}

model Tenant {
  id                    String               @id @default(cuid())
  firstName             String
  lastName              String
  email                 String               @unique
  phone                 String?
  dateOfBirth           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  vehicleInfo           String?
  petInfo               String?
  status                String               @default("invited")
  userId                String?              @unique
  user                  User?                @relation(fields: [userId], references: [id])
  unitId                String?
  unit                  Unit?                @relation(fields: [unitId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  leases                Lease[]
  payments              Payment[]
  maintenanceRequests   MaintenanceRequest[]
  messages              Message[]
  documents             Document[]
  autopay               AutoPay?
}

model Lease {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  unitId          String
  unit            Unit      @relation(fields: [unitId], references: [id])
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Float
  rentDueDay      Int       @default(1)
  gracePeriodDays Int       @default(5)
  lateFeeAmount   Float     @default(50)
  securityDeposit Float
  leasePdfUrl     String?
  status          String    @default("active") // active, expiring, renewed, terminated
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  payments        Payment[]
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
  WAIVED
  REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  leaseId         String
  lease           Lease         @relation(fields: [leaseId], references: [id])
  unitId          String
  unit            Unit          @relation(fields: [unitId], references: [id])
  rentAmount      Float
  lateFee         Float         @default(0)
  totalAmount     Float
  paidAmount      Float         @default(0)
  balanceDue      Float
  paymentMethod   String? // cash, check, Zelle, bank transfer, other
  referenceNumber String?
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  dueDate         DateTime
  receiptUrl      String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Future Stripe Integration Placeholders
  stripeCustomerId      String?
  stripePaymentIntentId String?
}

model PaymentMethod {
  id             String  @id @default(cuid())
  tenantId       String
  stripeMethodId String
  type           String // card, us_bank_account
  last4          String
  isDefault      Boolean @default(false)
}

model AutoPay {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  enabled         Boolean  @default(false)
  paymentMethodId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MaintenanceRequest {
  id                   String    @id @default(cuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  unitId               String
  unit                 Unit      @relation(fields: [unitId], references: [id])
  propertyId           String
  property             Property  @relation(fields: [propertyId], references: [id])
  category             String // plumbing, electrical, HVAC, appliance, pest, structural, other
  priority             String // low, medium, high, emergency
  description          String
  photos               String[]
  preferredAccessTimes String?
  status               String    @default("submitted") // submitted, reviewed, assigned, scheduled, in_progress, completed, tenant_confirmed
  assignedVendorId     String?
  vendor               Vendor?   @relation(fields: [assignedVendorId], references: [id])
  scheduledDate        DateTime?
  cost                 Float?
  adminNotes           String?
  tenantRating         Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Vendor {
  id                  String               @id @default(cuid())
  name                String
  companyName         String?
  email               String?
  phone               String?
  specialty           String?
  rating              Float?
  notes               String?
  createdAt           DateTime             @default(now())
  maintenanceRequests MaintenanceRequest[]
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  subject    String?
  body       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Announcement {
  id         String    @id @default(cuid())
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id])
  title      String
  content    String
  createdAt  DateTime  @default(now())
}

model Document {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  url       String
  type      String // Lease, ID, Income, Notice, etc.
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String?
  status    String   @default("sent")
  createdAt DateTime @default(now())
}
