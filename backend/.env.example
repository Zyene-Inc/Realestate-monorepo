# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coach_johnson_realty"

# Security
JWT_SECRET="generate-a-strong-secret-here"
JWT_REFRESH_SECRET="generate-another-strong-secret-here"
BACKEND_PORT=3001
FRONTEND_URL="http://localhost:3000"

# Email (SendGrid)
SENDGRID_API_KEY="SG.your_api_key_here"
EMAIL_FROM="noreply@yourdomain.com"

# Storage (S3 or Cloudflare R2)
STORAGE_PROVIDER=s3
S3_BUCKET_NAME="your-bucket-name"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_PUBLIC_URL="https://your-cdn-or-bucket-url.com"
