# Local development calls NestJS directly. On Vercel, omit this variable and
# set the server-only BACKEND_URL so Next.js proxies /api to the API project.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
BACKEND_URL=https://your-api-project.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://xwrlpqakdndpnqqpfepz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ifckzn2bSFAxGE-UYgVnJw_WOC2lRIf

# Production domain architecture. All six domains point to this same Vercel
# frontend project. These values also drive canonical role redirects.
NEXT_PUBLIC_ROOT_DOMAIN=coachjohnsonrealty.com
NEXT_PUBLIC_SITE_URL=https://coachjohnsonrealty.com
NEXT_PUBLIC_AGENT_PORTAL_URL=https://agents.coachjohnsonrealty.com
